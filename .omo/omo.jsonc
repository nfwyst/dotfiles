// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "default_mode": {
      "ultrawork": true,
      "goal": true
    },
    "hashline_edit": true,
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true
    },
    "team_mode": {
      "enabled": true,
      "tmux_visualization": true
    },
    "agents": {
      "sisyphus": {
        "model": "kimi-for-coding/k3",
        "reasoning": "max"
      },
      "hephaestus": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "oracle": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "max"
      },
      "librarian": {
        "model": "kimi-for-coding/k3-256k"
      },
      "explore": {
        "model": "kimi-for-coding/k3-256k"
      },
      "multimodal-looker": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "low"
      },
      "prometheus": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "metis": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "momus": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "max"
      },
      "omo-senpi-code-reviewer": {
        "model": "kimi-for-coding/k3-256k"
      },
      "omo-senpi-qa-executor": {
        "model": "kimi-for-coding/k3-256k"
      },
      "omo-senpi-gate-reviewer": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "max"
      },
      "atlas": {
        "model": "kimi-for-coding/k3-256k"
      },
      "sisyphus-junior": {
        "model": "kimi-for-coding/k3-256k"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "max"
      },
      "ultrabrain": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "max"
      },
      "deep": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "artistry": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "quick": {
        "model": "kimi-for-coding/kimi-for-coding-highspeed"
      },
      "unspecified-low": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "unspecified-high": {
        "model": "kimi-for-coding/k3-256k",
        "reasoning": "high"
      },
      "writing": {
        "model": "kimi-for-coding/k3-256k"
      }
    },
    "codegraph": {
      "auto_init": true
    }
  },
  "codegraph": {
    "enabled": true,
    "auto_provision": true,
    "daemon": true,
    "telemetry": false
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
