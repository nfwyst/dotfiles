// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "hashline_edit": true,
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true
    },
    "team_mode": {
      "enabled": true
    },
    "agents": {
      "sisyphus": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "hephaestus": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "oracle": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "librarian": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "explore": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "multimodal-looker": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "prometheus": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "metis": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "momus": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "atlas": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "sisyphus-junior": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "ultrabrain": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "deep": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "artistry": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
