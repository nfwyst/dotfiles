      },
      "unspecified-low": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "unspecified-high": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      },
      "writing": {
        "model": "opencode/muse-spark-1.3-contributor-free",
        "reasoning": "xhigh"
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification"
  ]
}
